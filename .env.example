# =============================================================================
# Madeireira — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e preencha. NUNCA versione o .env*.
# =============================================================================

# --- Site -------------------------------------------------------------------
# URL pública (usada em SEO, sitemap, Open Graph e links de webhook)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (publishable/anon). Pode ir para o navegador; a segurança vem do RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Chave secreta (secret/service_role). SOMENTE servidor. Ignora o RLS.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Banco (Project Settings → Database → Connection string) ----------------
# Pooler em modo transaction (porta 6543) — usado pela aplicação (serverless).
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Conexão direta/sessão (porta 5432) — usada pelo drizzle-kit nas migrations.
DIRECT_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# --- NF-e ------------------------------------------------------------------
# homologacao | producao  (em homologação a tela mostra um aviso grande)
NFE_AMBIENTE=homologacao
# Provedor de emissão: focus | nuvemfiscal | plugnotas | nfeio | sefaz (futuro)
NFE_PROVIDER=focus
# Focus NFe — token do ambiente correspondente (painel Focus → Tokens)
FOCUS_NFE_TOKEN=
# Segredo compartilhado para validar o webhook do provedor
NFE_WEBHOOK_SECRET=

# Provedor direto com a SEFAZ (ainda não implementado — ver lib/fiscal/README)
# NFE_CERTIFICADO_PFX_BASE64=
# NFE_CERTIFICADO_SENHA=

# --- Landing page ------------------------------------------------------------
# WhatsApp do botão flutuante, só dígitos com DDI+DDD (ex.: 5542999999999)
NEXT_PUBLIC_WHATSAPP=
